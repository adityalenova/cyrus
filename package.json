{
  "name": "cyrus-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "cyrus.ai — developer programs, organizations and AI-agent projects catalog",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 5330",
    "build": "next build",
    "start": "next start -p 5330",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && next build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "refresh": "node scripts/refresh.mjs",
    "orgs": "node scripts/fetch-orgs.mjs",
    "gh-relay": "node scripts/github-exchange.local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.5.0",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
