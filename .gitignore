node_modules/
dist/

# build output - regenerated by npm run build, never a source file
.next/
out/
*.tsbuildinfo

# local QA screenshots from scripts/mobile-audit.ts
.shots/

# Playwright run output - traces and reports, regenerated by `npm run test:e2e`
test-results/
playwright-report/

.env
.env.local

# local GitHub token-exchange relay secret - never commit
.github-secret
scripts/org-login-cache.json
.DS_Store
.vercel
.env*

# raw GitHub crawl output - regenerable with scripts/crawl-github.mjs,
# and the derived modules in src/data are what the app reads
/data/

# local run logs from the roster/resolve scripts
scratch/logs/

# local fetch cache written by the roster scripts - regenerable
scripts/.cache/
